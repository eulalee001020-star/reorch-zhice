# Application
APP_ENV=development
APP_DEBUG=true
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Staging/production require durable Agent trace and audit persistence by default.
APP_REQUIRE_DURABLE_PERSISTENCE=false

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=reorch
DB_PASSWORD=reorch
DB_NAME=reorch
DB_ECHO=false

# Redis / ARQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_GROUP_ID=reorch

# Controlled Agent runtime budgets. Mandatory stages fail closed on timeout.
AGENT_IMPACT_TIMEOUT_SECONDS=15
AGENT_STRATEGY_TIMEOUT_SECONDS=15
AGENT_SOLVER_TIMEOUT_SECONDS=65
AGENT_EVALUATION_TIMEOUT_SECONDS=15
AGENT_EXPLANATION_TIMEOUT_SECONDS=12

# CPU-heavy solver capacity. Tune from measured customer-like load, not guesswork.
SOLVER_MAX_CONCURRENT_JOBS=2
SOLVER_QUEUE_TIMEOUT_SECONDS=2
SOLVER_CP_SAT_WORKERS=4
SOLVER_MAX_MODEL_OPERATIONS=2000
SOLVER_HEURISTIC_BUDGET_RATIO=0.20
SOLVER_HEURISTIC_MAX_SECONDS=2
SOLVER_INITIAL_CP_SAT_BUDGET_RATIO=0.65
SOLVER_MAX_ALNS_ITERATIONS=4
RUNTIME_DATABASE_URL=
RUNTIME_LOCAL_DATABASE_PATH=output/reorch_runtime.db
RUNTIME_DEFAULT_MAX_QUEUED_JOBS=20
RUNTIME_DEFAULT_MAX_RUNNING_JOBS=2
RUNTIME_DEFAULT_MAX_OPERATIONS_PER_JOB=10000
RUNTIME_SOLVE_LEASE_SECONDS=30

# Enterprise OIDC. Keep AUTH_MODE=api_key until issuer, audience, JWKS, roles,
# and tenant claims have been validated with the customer IdP.
AUTH_MODE=api_key
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URL=
AUTH_OIDC_ALGORITHMS=RS256
AUTH_OIDC_ROLE_CLAIM=roles
AUTH_OIDC_TENANT_CLAIM=tenant_id
AUTH_OIDC_ROLE_MAPPING=planner=Planner,shop_floor_executor=Shop_Floor_Executor,management=Management,it_admin=IT_Admin

# PoC auth users:
# username:password:user_id:role:api_key:display_name
AUTH_USERS=planner:planner123:planner-1:Planner:planner-key-001:Planner,executor:executor123:executor-1:Shop_Floor_Executor:executor-key-001:Executor,manager:manager123:mgmt-1:Management:mgmt-key-001:Manager,admin:admin123:admin-1:IT_Admin:admin-key-001:Admin
# Customer staging/production deployments must set this to true.
AUTH_REQUIRE_API_KEY=false
# Required for sandbox writeback. Generate a random value with at least 32 characters.
AUTH_WRITEBACK_PERMIT_SECRET=
AUTH_RECOVERY_APPROVAL_SECRET=
AUTH_WRITEBACK_PERMIT_TTL_SECONDS=300

# Customer-system adapters. Leave blank for local PoC mode.
# For Docker Compose sandbox联调, use http://mock-integration:8010.
INTEGRATION_MES_BASE_URL=
INTEGRATION_MES_API_KEY=
INTEGRATION_MES_WRITEBACK_PATH=/api/schedule/writeback
INTEGRATION_MES_PROGRESS_PATH=/api/execution/progress
INTEGRATION_MES_HEALTH_PATH=/health
INTEGRATION_MES_FORMAT=standard
# External writeback is disabled by default. The current product supports only
# explicit, second-approved sandbox execution; production writeback stays blocked.
INTEGRATION_WRITEBACK_MODE=disabled
INTEGRATION_MES_TARGET_ENVIRONMENT=local
# Enable only after an active Writeback Adapter Certification exists for this adapter.
INTEGRATION_REQUIRE_CERTIFIED_WRITEBACK_ADAPTER=false
INTEGRATION_WRITEBACK_ADAPTER_ID=mes-default

INTEGRATION_ERP_APS_BASE_URL=
INTEGRATION_ERP_APS_API_KEY=
INTEGRATION_ERP_APS_SNAPSHOT_PATH=/api/schedule/snapshot
INTEGRATION_ERP_APS_RESOURCES_PATH=/api/resources
INTEGRATION_ERP_APS_WORK_ORDERS_PATH=/api/work-orders
INTEGRATION_ERP_APS_HEALTH_PATH=/health

INTEGRATION_IOT_BASE_URL=
INTEGRATION_IOT_API_KEY=
INTEGRATION_IOT_EVENTS_PATH=/api/events
INTEGRATION_IOT_HEALTH_PATH=/health
INTEGRATION_REQUEST_TIMEOUT_SECONDS=10

# Optional LLM for low-risk understanding, rule-candidate, and explanation steps.
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=configured-small-agent-model
LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=60
LLM_MAX_PAYLOAD_BYTES=65536

# CSV adapter offline import directory, if used by custom scripts/tests.
INTEGRATION_CSV_DATA_DIR=
